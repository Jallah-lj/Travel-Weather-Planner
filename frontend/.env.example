# Public OSM-derived vector maps, hosted by OpenFreeMap (not OSM public raster tiles).
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
VITE_MAP_PROVIDER_NAME=OpenFreeMap
# Custom MapLibre styles must preserve data/provider attribution in their sources.
# VITE_* values are public. Never place secret keys here.
