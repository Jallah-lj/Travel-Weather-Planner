# Vercel BACKEND project only. Never prefix secrets with VITE_.
ENVIRONMENT=production
AUTH_PROVIDER=supabase
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE
# Runtime role from infrastructure/supabase-runtime-role.sql, transaction pooler.
# Copy actual pooler host from Supabase Connect. URL-encode the password.
DATABASE_URL=postgresql+psycopg://travel_app.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
DATABASE_NULL_POOL=true
# Migration URL belongs on your trusted migration machine/CI ONLY, not Vercel runtime.
# DATABASE_MIGRATION_URL=postgresql+psycopg://postgres:ENCODED_PASSWORD@DIRECT_HOST:5432/postgres?sslmode=require
REDIS_URL=rediss://default:ENCODED_PASSWORD@REDIS_HOST:6379/0
SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ALLOWED_ORIGINS=https://YOUR_FRONTEND.vercel.app
WEATHER_PROVIDER=openmeteo
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
WEATHER_API_KEY=
# Use a managed/self-hosted Photon-compatible service for production scale.
GEOCODING_URL=https://photon.komoot.io/api/
AI_PROVIDER=gemini
AI_MODEL=gemini-3.6-flash
AI_API_KEY=
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_BROWSER_KEY=
# Set only after completing the legal and provider checklist.
GOOGLE_MAPS_LEGAL_APPROVED=false
LOG_LEVEL=INFO
