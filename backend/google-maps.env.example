# Google Maps Platform — SEPARATE from the Gemini API key.
# Add these to backend/.env; do not commit real server credentials.
# 1. Enable Places API (New), Routes API and Maps JavaScript API with billing.
# 2. Server key: restrict to Places API (New) and Routes API + server egress IP(s).
# 3. Browser key: restrict to Maps JavaScript API + exact website referrer hosts.
# Both keys should belong to the same intended Maps project. Never use the same key.
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_BROWSER_KEY=

# Application ceilings, not Google quota or free-tier entitlements.
GOOGLE_ROUTES_PER_USER_MINUTE=6
GOOGLE_ROUTES_PER_USER_DAY=100
GOOGLE_ROUTES_PER_DAY=1000
GOOGLE_PLACES_PER_USER_MINUTE=30
GOOGLE_PLACES_PER_USER_DAY=300
GOOGLE_PLACES_PER_DAY=3000

# Set true only AFTER reviewing/publishing operator-specific terms/privacy.
# Production also requires connected Redis for cross-worker quota enforcement.
GOOGLE_MAPS_LEGAL_APPROVED=false
